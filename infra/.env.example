# Copia este fichero a infra/.env para sobreescribir las credenciales por
# defecto del backend sin tocar docker-compose.yml. docker compose carga
# infra/.env automáticamente porque está en el mismo directorio que el compose file.

VECTORRT_USERNAME=admin
VECTORRT_PASSWORD=changeme
# Genera una clave propia: python3 -c "import secrets; print(secrets.token_hex(32))"
VECTORRT_SECRET_KEY=dev-secret-change-me
