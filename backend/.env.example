# VectorRT backend — variables de entorno
# La whitelist de targets vive en app/config.py (son IPs de laboratorio, no secretas).

APP_ENV=development
LOG_LEVEL=INFO

# Login de la plataforma (Fase 4.1). Cámbialos antes de exponer esto a nada
# que no sea tu propia máquina — con los valores por defecto el backend arranca
# igual, pero avisa por log de que está usando credenciales de desarrollo.
VECTORRT_USERNAME=admin
VECTORRT_PASSWORD=changeme
# Clave de firma de los tokens de sesión (JWT). Genera una propia, por ejemplo:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
VECTORRT_SECRET_KEY=dev-secret-change-me
